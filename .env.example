# ─────────────────────────────────────────────────────────────────────────────
# Travel World Colombia — variables de entorno
# Copia este archivo a .env.local y completa los valores (nunca commitees .env.local).
# En Vercel: Settings → Environment Variables (Production / Preview / Development).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sitio ──
# URL canónica del sitio. Alimenta metadataBase, canonical, sitemap, robots y JSON-LD.
# Producción (post-cutover): https://travelworldcolombia.com
# Producción (pre-cutover):  https://travel-world-colombia.vercel.app
# Preview: definirla también (si falta, los previews emiten canonical de producción).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo servidor (panel admin, allowlist, agente). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres (scripts puntuales).
SUPABASE_DB_URL=

# ── Panel admin ──
# Superadmins de arranque, separados por coma. No se pueden revocar desde el panel.
ADMIN_EMAILS=

# ── Rate limiting (Upstash Redis, integración del Marketplace de Vercel) ──
# Si faltan, el rate limit cae a un contador en memoria (no fiable en serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alias que inyecta la integración KV de Vercel (equivalentes a los de arriba).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Agente Sol (WhatsApp/IG/FB vía GHL) ──
ANTHROPIC_API_KEY=
# Private Integration Token de la subcuenta GHL de TWC.
GHL_TWC_PIT=
# Secreto compartido del webhook /api/agente/webhook.
AGENTE_WEBHOOK_SECRET=
# Solo responde conversaciones creadas después de esta fecha ISO (vacío = todas).
AGENTE_ACTIVO_DESDE=
# Ventana de agrupación de mensajes en ms (ráfaga). 0 = desactivada.
AGENTE_RAFAGA_MS=
# Tag de pruebas: si está definido, Sol solo responde a contactos con ese tag.
AGENTE_TAG_PRUEBAS=

# ── Crons de Vercel (seguimiento del agente) ──
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" a /api/agente/*.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Transcripción de audios (OpenAI STT) ──
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=

# ── Analytics (P3 — los componentes solo se montan si el ID existe) ──
# Contenedor GTM nuevo (formato GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=
# Meta Pixel (por defecto se reutiliza el histórico salvo contaminación).
NEXT_PUBLIC_FB_PIXEL_ID=
# Propiedad GA4 (formato G-XXXXXXXXXX). Se configura como tag dentro de GTM.
NEXT_PUBLIC_GA4_ID=
# Meta Conversions API (server-side, /api/meta-capi).
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
