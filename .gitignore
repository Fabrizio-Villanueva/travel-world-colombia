# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# dumps de contactos/webhooks de GHL (contienen PII — nunca versionar)
c2.json
*.ghl.json
*.dump.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots de verificacion (playwright)
scripts/*.png

# imágenes brutas y optimizadas (no van al repo — subir a Supabase Storage)
/raw-images/
/optimized-images/
# fotos de destinos van a Supabase; logos de alianzas y fotos de viajeros SÍ se commitean (assets estáticos)
/public/img/*
!/public/img/alianzas/
!/public/img/viajeros/
!/public/img/equipo/
!/public/img/paginas/
!/public/img/pagos/
!/public/img/asistencia/
